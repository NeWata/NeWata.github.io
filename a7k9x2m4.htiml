<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админ-панель</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { background: #0a0a12; color: #e0dcc8; min-height: 100vh; display: flex; align-items: center; justify-content: center; flex-direction: column; }

        .login-box {
            background: #161624;
            padding: 40px;
            border-radius: 20px;
            border: 1px solid #2e2e48;
            width: 380px;
            max-width: 92%;
            box-shadow: 0 30px 80px rgba(0,0,0,0.9);
        }
        .login-box h2 { color: #f0e8c8; font-size: 24px; font-weight: 300; text-align: center; margin-bottom: 8px; }
        .login-box p { color: #666; font-size: 14px; text-align: center; margin-bottom: 24px; }
        .login-box .form-group { margin-bottom: 16px; }
        .login-box .form-group label { display: block; font-size: 12px; color: #888; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px; }
        .login-box .form-group input {
            width: 100%; padding: 12px 16px; border-radius: 10px;
            border: 1px solid #2a2a40; background: #0a0a12;
            color: #eee; font-size: 15px; outline: none;
        }
        .login-box .form-group input:focus { border-color: #d4c08a; }
        .login-box button {
            width: 100%; padding: 12px; border-radius: 10px;
            border: none; background: #d4c08a;
            color: #0a0a12; font-size: 16px; font-weight: 600;
            cursor: pointer; transition: 0.2s;
        }
        .login-box button:hover { background: #e8d4a0; }
        .login-box .error-msg { color: #ff5555; font-size: 13px; text-align: center; margin-top: 12px; display: none; }
    </style>
</head>
<body>
    <div class="login-box">
        <h2>Вход в админ-панель</h2>
        <p>Введите email и пароль администратора</p>
        <div class="form-group">
            <label>Email</label>
            <input type="email" id="login-email" placeholder="tsumimak21@gmail.com">
        </div>
        <div class="form-group">
            <label>Пароль</label>
            <input type="password" id="login-password" placeholder="Введите пароль">
        </div>
        <button id="login-btn">Войти</button>
        <div class="error-msg" id="login-error">Неверный email или пароль</div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        const SUPABASE_URL = 'https://ufekhgjpxnnoutiikkjk.supabase.co';
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVmZWtoZ2pweG5ub3V0aWlra2prIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcwNzIwNTYsImV4cCI6MjEwMjY0ODA1Nn0.Wc5_W5sD6VAVZVCg5hBlj2zvQCE72gTdX5KUXo0mqvs';
        const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        document.getElementById('login-btn').addEventListener('click', async function() {
            const email = document.getElementById('login-email').value.trim();
            const password = document.getElementById('login-password').value;
            const errorEl = document.getElementById('login-error');

            if (!email || !password) {
                errorEl.textContent = 'Заполните email и пароль';
                errorEl.style.display = 'block';
                return;
            }

            try {
                const { data, error } = await supabaseClient.auth.signInWithPassword({
                    email: email,
                    password: password
                });

                if (error) {
                    errorEl.textContent = 'Неверный email или пароль';
                    errorEl.style.display = 'block';
                    return;
                }

                errorEl.style.display = 'none';
                alert('Вход выполнен! Добро пожаловать в админ-панель!');
                // После входа можно показать админ-панель
            } catch (e) {
                errorEl.textContent = 'Ошибка входа';
                errorEl.style.display = 'block';
            }
        });

        document.getElementById('login-password').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') document.getElementById('login-btn').click();
        });
        document.getElementById('login-email').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') document.getElementById('login-btn').click();
        });
    </script>
</body>
</html>
